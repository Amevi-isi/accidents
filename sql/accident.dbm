	</column>
	<column name="submission_time">
		<type name="timestamp" length="0"/>
	</column>
	<column name="photo_lieu">
		<type name="text" length="0"/>
	</column>
	<column name="croquis_accident">
		<type name="text" length="0"/>
	</column>
	<column name="intervention">
		<type name="text" length="0"/>
	</column>
	<column name="hopital_evacue">
		<type name="text" length="0"/>
	</column>
	<column name="contact_parent">
		<type name="text" length="0"/>
	</column>
	<column name="latitude">
		<type name="float8" length="0"/>
	</column>
	<column name="longitude">
		<type name="float8" length="0"/>
	</column>
	<constraint name="accidents_pk" type="pk-constr" table="public.accidents">
		<columns names="submission_id" ref-type="src-columns"/>
	</constraint>
</table>

