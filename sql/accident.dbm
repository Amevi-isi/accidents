<relationship name="accidents_has_many_vehicules" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#b356da"
	 src-table="public.accidents"
	 dst-table="public.vehicules"
	 src-required="false" dst-required="false"/>

<relationship name="vehicules_has_many_passagers" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#ae9e34"
	 src-table="public.vehicules"
	 dst-table="public.passagers"
	 src-required="false" dst-required="false"/>

<relationship name="accidents_has_many_pietons" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 custom-color="#607c0d"
	 src-table="public.accidents"
	 dst-table="public.pietons"
	 src-required="false" dst-required="false"/>

</dbmodel>
